# Single source of truth for the compose project name. `docker compose`
# auto-loads a .env file from its working directory (both up.sh and down.sh
# `cd` into this directory before running any `docker compose` command), so
# this is honored by any invocation against this stack without needing a
# duplicated `export COMPOSE_PROJECT_NAME=...` in each script.
#
# This is the Compose v1-compatible mechanism: the newer top-level `name:`
# key in docker-compose.yml (Compose Specification) is NOT used here because
# the `docker compose` CLI available in this environment (v2.2.3) predates
# that key and rejects it ("Additional property name is not allowed").
#
# Pinned to avoid a project-name collision with unrelated compose stacks on
# a shared Docker daemon — see docs/api-notes.md, "Task 16 addendum". Do not
# remove.
COMPOSE_PROJECT_NAME=glitchtip-tf-acceptance
